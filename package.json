{
  "name": "crt-terminal",
  "version": "0.1.0",
  "private": true,
  "description": "Retro CRT-styled terminal with plugin panels, for Windows, macOS and Linux",
  "license": "MIT",
  "keywords": [
    "terminal",
    "crt",
    "retro",
    "electron",
    "xterm",
    "cool-retro-term"
  ],
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "smoke:pty": "electron scripts/pty-smoke.cjs",
    "dev:css": "cross-env CRT_MODE=css electron-vite dev",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "~5.9",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "author": {
    "name": "CRT Terminal contributors"
  },
  "homepage": "https://github.com/Kab0tan/custom-retro-term",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kab0tan/custom-retro-term.git"
  },
  "bugs": {
    "url": "https://github.com/Kab0tan/custom-retro-term/issues"
  }
}
