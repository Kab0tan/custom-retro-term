{
  "id": "spectrum",
  "name": "Spectrum",
  "version": "1.0.0",
  "apiVersion": 1,
  "description": "Frequency spectrum of system audio (analysed live, never recorded).",
  "entry": "index.js",
  "defaultTitle": "SPECTRUM",
  "data": ["audio"],
  "settings": [
    { "key": "bars", "label": "Bands", "type": "number", "default": 48, "min": 16, "max": 128, "step": 8 },
    { "key": "smoothing", "label": "Smoothing", "type": "number", "default": 0.6, "min": 0, "max": 0.95, "step": 0.05 },
    { "key": "peakHold", "label": "Peak hold", "type": "boolean", "default": true },
    { "key": "labels", "label": "Frequency labels", "type": "boolean", "default": true }
  ]
}
