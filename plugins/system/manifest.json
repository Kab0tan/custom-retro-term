{
  "id": "system",
  "name": "System stats",
  "version": "1.1.0",
  "apiVersion": 1,
  "description": "SYSMON: a bar per CPU core, memory, network throughput and temperature, live.",
  "entry": "index.js",
  "defaultTitle": "SYSMON",
  "data": ["cpu", "memory", "network", "temperature"],
  "settings": [
    { "key": "showCores", "label": "Per-core bars", "type": "boolean", "default": true },
    { "key": "showNetwork", "label": "Network", "type": "boolean", "default": true },
    { "key": "showTemperature", "label": "Temperature", "type": "boolean", "default": true }
  ]
}
